{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFleetDocuments",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
